root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning
csharp_new_line_before_open_brace = types,methods,anonymous_methods,anonymous_types,control_blocks,local_functions
